@@ -0,0 +1,319 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Temporary 260 MHz / Wi-Fi recovery experiment; never changes the boot clock.
+// BBPLL approach checked against ESP-IDF S3 LL; precedent Neol00/OpenWatchFace (GPL-3.0).
+#include "clock_wifi.hpp"
+#include "sdkconfig.h"
+#if CONFIG_DAW_CLOCK_TRIAL
+#include <atomic>
+#include "audio_out.hpp"
+#include "control.hpp"
+#include "web_server.hpp"
+#include "esp_attr.h"
+#include "esp_cpu.h"
+#include "esp_event.h"
+#include "esp_heap_caps.h"
+#include "esp_netif.h"
+#include "esp_private/cache_utils.h"
+#include "esp_rom_regi2c.h"
+#include "esp_rom_sys.h"
+#include "esp_system.h"
+#include "esp_timer.h"
+#include "esp_wifi.h"
+#include "driver/gptimer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "hal/clk_tree_ll.h"
+#include "hal/mspi_ll.h"
+#include "hal/wdt_hal.h"
+#include "soc/regi2c_bbpll.h"
+#include "soc/rtc.h"
+
+static constexpr uint32_t kMagic = 0xc10c0271;
+static constexpr unsigned kWords = 16384;
+static std::atomic<bool> s_busy{false}, s_ip{false}, s_connected{false}, s_stopped{false};
+static std::atomic<uint32_t> s_actualKhz{0};
+static daw::Engine *s_engine;
+static volatile uint32_t *s_probe;
+static wifi_config_t s_wifi; // private credentials, RAM only, never included in diagnostics
+static wdt_hal_context_t s_rescue;
+static gptimer_handle_t s_apbProbe;
+static uint32_t s_bootApbHz;
+static std::atomic<uint32_t> s_apbHz{0};
+static bool s_slowMemory;
+static uint32_t s_flash0, s_flash1, s_psram0, s_flashDiv0, s_flashDiv1, s_psramDiv;
+struct Event { uint32_t ms, stage; int32_t id, reason; };
+struct Sample { uint32_t ms, khz, cpu, overruns, underruns, playing, tick, guardDrops; uint64_t frames; };
+struct Trace {
+    uint32_t magic, target, mode, stage, beforeStartKhz, afterInitKhz, afterStartKhz, restoredKhz;
+    uint32_t eventCount, sampleCount, gotIpMs, ipEver, scanAps, scanDone, stopConfirmed;
+    uint32_t slowMemory, mspiCoreSelect, flashClockBefore, psramClockBefore, flashClockActive, psramClockActive;
+    uint32_t bootApbHz, afterStartApbHz, restoredApbHz;
+    int32_t canary, calls[12]; int64_t startUs;
+    Event events[32]; Sample samples[24];
+};
+static RTC_NOINIT_ATTR Trace s_trace;
+
+static uint32_t measuredApbHz()
+{
+    // Configure once at stock: APB80 / prescaler80 = 1 MHz. Raw counter timing is then
+    // compared to independent XTAL SYSTIMER; it cannot be fooled by cached clock reports.
+    uint64_t c0, c1; ESP_ERROR_CHECK(gptimer_get_raw_count(s_apbProbe, &c0));
+    const int64_t t0 = esp_timer_get_time();
+    while (esp_timer_get_time() - t0 < 2000) {}
+    ESP_ERROR_CHECK(gptimer_get_raw_count(s_apbProbe, &c1));
+    const int64_t t1 = esp_timer_get_time();
+    const uint32_t hz = (c1 - c0) * 80000000ull / (t1 - t0);
+    s_apbHz = hz; return hz;
+}
+
+static void event(void *, esp_event_base_t base, int32_t id, void *data)
+{
+    if (!s_busy || s_trace.magic != kMagic || s_trace.stage >= 8) return;
+    int reason = 0;
+    if (base == WIFI_EVENT) {
+        if (id == WIFI_EVENT_STA_STOP) s_stopped = true;
+        if (id == WIFI_EVENT_STA_CONNECTED) s_connected = true;
+        if (id == WIFI_EVENT_STA_DISCONNECTED) {
+            reason = static_cast<wifi_event_sta_disconnected_t *>(data)->reason;
+            s_connected = false; s_ip = false;
+        }
+        if (id == WIFI_EVENT_SCAN_DONE) {
+            auto *e = static_cast<wifi_event_sta_scan_done_t *>(data);
+            s_trace.scanDone = 1; s_trace.scanAps = e->number; reason = e->status;
+        }
+    } else {
+        s_ip = true; s_connected = true; s_trace.ipEver = 1;
+        s_trace.gotIpMs = (esp_timer_get_time() - s_trace.startUs) / 1000;
+        id += 1000; // IP event namespace, no network addresses or credentials
+    }
+    const unsigned n = s_trace.eventCount;
+    if (n < 32) {
+        s_trace.events[n] = {static_cast<uint32_t>((esp_timer_get_time() - s_trace.startUs) / 1000), s_trace.stage, id, reason};
+        s_trace.eventCount = n + 1;
+    }
+}
+
+void clockWifiBind(daw::Engine *engine)
+{
+    s_engine = engine;
+    gptimer_config_t cfg = {}; cfg.clk_src = GPTIMER_CLK_SRC_APB;
+    cfg.direction = GPTIMER_COUNT_UP; cfg.resolution_hz = 1000000;
+    ESP_ERROR_CHECK(gptimer_new_timer(&cfg, &s_apbProbe));
+    ESP_ERROR_CHECK(gptimer_enable(s_apbProbe)); ESP_ERROR_CHECK(gptimer_start(s_apbProbe));
+    s_bootApbHz = measuredApbHz();
+    ESP_ERROR_CHECK(esp_event_handler_register(WIFI_EVENT, ESP_EVENT_ANY_ID, event, nullptr));
+    ESP_ERROR_CHECK(esp_event_handler_register(IP_EVENT, IP_EVENT_STA_GOT_IP, event, nullptr));
+}
+
+static void rescueArm()
+{
+    wdt_hal_init(&s_rescue, WDT_RWDT, 0, false);
+    wdt_hal_write_protect_disable(&s_rescue);
+    const uint32_t hz = rtc_clk_slow_freq_get_hz();
+    wdt_hal_config_stage(&s_rescue, WDT_STAGE0, hz * 40, WDT_STAGE_ACTION_RESET_SYSTEM);
+    wdt_hal_config_stage(&s_rescue, WDT_STAGE1, hz * 2, WDT_STAGE_ACTION_RESET_RTC);
+    wdt_hal_enable(&s_rescue); wdt_hal_write_protect_enable(&s_rescue);
+}
+
+static void IRAM_ATTR switchClock(uint32_t mhz)
+{
+    spi_flash_disable_interrupts_caches_and_other_cpu();
+    clk_ll_cpu_set_src(SOC_CPU_CLK_SRC_XTAL); esp_rom_set_cpu_ticks_per_us(40);
+    if (s_slowMemory && mhz > 240) {
+        mspi_timing_ll_set_flash_clock(0, s_flashDiv0 * 2);
+        mspi_timing_ll_set_flash_clock(1, s_flashDiv1 * 2);
+        mspi_timing_ll_set_psram_clock(0, s_psramDiv * 2);
+    }
+    esp_rom_regi2c_write(I2C_BBPLL, I2C_BBPLL_HOSTID, I2C_BBPLL_OC_DIV_7_0, static_cast<uint8_t>(mhz / 20 - 4));
+    REG_SET_FIELD(SYSTEM_CPU_PER_CONF_REG, SYSTEM_PLL_FREQ_SEL, 1);
+    esp_rom_delay_us(100);
+    clk_ll_cpu_set_freq_mhz_from_pll(240); clk_ll_cpu_set_src(SOC_CPU_CLK_SRC_PLL);
+    esp_rom_set_cpu_ticks_per_us(mhz);
+    if (s_slowMemory && mhz == 240) {
+        REG_WRITE(SPI_MEM_CLOCK_REG(0), s_flash0); REG_WRITE(SPI_MEM_CLOCK_REG(1), s_flash1);
+        REG_WRITE(SPI_MEM_SRAM_CLK_REG(0), s_psram0);
+    }
+    spi_flash_enable_interrupts_caches_and_other_cpu();
+}
+
+static uint32_t measuredKhz()
+{
+    const int64_t t0 = esp_timer_get_time(); const uint32_t c0 = esp_cpu_get_cycle_count();
+    int64_t t1; do { t1 = esp_timer_get_time(); } while (t1 - t0 < 1000);
+    const uint32_t khz = uint64_t(esp_cpu_get_cycle_count() - c0) * 1000 / (t1 - t0);
+    s_actualKhz = khz;
+    // PHY initialization may retune the PLL: never trust the cached CPU-frequency number.
+    if (khz > 230000 && khz < 270000) esp_rom_set_cpu_ticks_per_us(khz < 250000 ? 240 : 260);
+    return khz;
+}
+
+static bool checkRam()
+{
+    for (unsigned i = 0; i < kWords; ++i) s_probe[i] = i * 2654435761u ^ 0x59a36cb7u;
+    for (unsigned i = 0; i < kWords; ++i) if (s_probe[i] != (i * 2654435761u ^ 0x59a36cb7u)) return false;
+    return true;
+}
+
+static void sample()
+{
+    if (s_trace.sampleCount >= 24) return;
+    const uint32_t khz = measuredKhz(); auto &e = s_engine->status(); auto &a = daw::audioOutStats();
+    s_trace.samples[s_trace.sampleCount++] = {static_cast<uint32_t>((esp_timer_get_time() - s_trace.startUs) / 1000),
+        khz, e.cpuPermille.load(), e.overruns.load(), a.underruns.load(), e.playing.load(),
+        static_cast<uint32_t>(e.tick.load()), e.cpuGuardDrops.load(), a.frames.load()};
+}
+
+static void waitSampled(uint32_t ms)
+{
+    const int64_t until = esp_timer_get_time() + int64_t(ms) * 1000;
+    int64_t next = esp_timer_get_time();
+    while (esp_timer_get_time() < until) {
+        if (esp_timer_get_time() >= next) { sample(); next += 1000000; }
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    sample();
+}
+
+static bool restartWifi(uint32_t mode)
+{
+    if (mode == 2) {
+        if ((s_trace.calls[2] = esp_wifi_deinit()) != ESP_OK) return false;
+        wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT(); cfg.nvs_enable = 0;
+        if ((s_trace.calls[3] = esp_wifi_init(&cfg)) != ESP_OK) return false;
+        s_trace.afterInitKhz = measuredKhz();
+        if ((s_trace.calls[4] = esp_wifi_set_storage(WIFI_STORAGE_RAM)) != ESP_OK) return false;
+        if ((s_trace.calls[5] = esp_wifi_set_mode(WIFI_MODE_STA)) != ESP_OK) return false;
+        if ((s_trace.calls[6] = esp_wifi_set_config(WIFI_IF_STA, &s_wifi)) != ESP_OK) return false;
+    }
+    if ((s_trace.calls[7] = esp_wifi_start()) != ESP_OK) return false;
+    s_trace.afterStartKhz = measuredKhz();
+    s_trace.afterStartApbHz = measuredApbHz();
+    s_trace.calls[8] = esp_wifi_set_ps(WIFI_PS_NONE);
+    return (s_trace.calls[9] = esp_wifi_connect()) == ESP_OK;
+}
+
+static void trialTask(void *arg)
+{
+    const uint32_t encoded = reinterpret_cast<uintptr_t>(arg), mhz = encoded & 0xffff, mode = encoded >> 16;
+    vTaskDelay(pdMS_TO_TICKS(500)); // acknowledgement sent before network disruption
+    s_trace = {}; s_trace.magic = kMagic; s_trace.target = mhz; s_trace.mode = mode;
+    for (auto &v : s_trace.calls) v = -99999;
+    s_trace.startUs = esp_timer_get_time(); s_trace.stage = 1;
+    s_trace.bootApbHz = s_bootApbHz;
+    s_slowMemory = mode == 3; s_trace.slowMemory = s_slowMemory;
+    s_flash0 = REG_READ(SPI_MEM_CLOCK_REG(0)); s_flash1 = REG_READ(SPI_MEM_CLOCK_REG(1));
+    s_psram0 = REG_READ(SPI_MEM_SRAM_CLK_REG(0));
+    s_flashDiv0 = (s_flash0 & SPI_MEM_CLK_EQU_SYSCLK) ? 1 : REG_GET_FIELD(SPI_MEM_CLOCK_REG(0), SPI_MEM_CLKCNT_N) + 1;
+    s_flashDiv1 = (s_flash1 & SPI_MEM_CLK_EQU_SYSCLK) ? 1 : REG_GET_FIELD(SPI_MEM_CLOCK_REG(1), SPI_MEM_CLKCNT_N) + 1;
+    s_psramDiv = (s_psram0 & SPI_MEM_SCLK_EQU_SYSCLK) ? 1 : REG_GET_FIELD(SPI_MEM_SRAM_CLK_REG(0), SPI_MEM_SCLKCNT_N) + 1;
+    s_trace.flashClockBefore = s_flash0; s_trace.psramClockBefore = s_psram0;
+    s_trace.mspiCoreSelect = REG_GET_FIELD(SPI_MEM_CORE_CLK_SEL_REG(0), SPI_MEM_CORE_CLK_SEL);
+    rescueArm();
+    daw::web::netTrialOwnWifi(true); // suppress normal reconnect/fallback during this controlled experiment
+    s_connected = mode == 0; s_ip = mode == 0;
+    bool ok = true;
+    s_trace.calls[0] = esp_wifi_get_config(WIFI_IF_STA, &s_wifi);
+    if (mode != 0) {
+        ok = s_trace.calls[0] == ESP_OK;
+        s_stopped = false;
+        if (ok) ok = (s_trace.calls[1] = esp_wifi_stop()) == ESP_OK;
+        const int64_t until = esp_timer_get_time() + 500000;
+        while (ok && !s_stopped && esp_timer_get_time() < until) vTaskDelay(pdMS_TO_TICKS(10));
+        s_trace.stopConfirmed = s_stopped.load();
+        s_connected = false; s_ip = false;
+    }
+    if (ok) {
+        s_trace.stage = 2;
+        switchClock(mhz);
+        s_trace.stage = 3;
+        s_trace.flashClockActive = REG_READ(SPI_MEM_CLOCK_REG(0));
+        s_trace.psramClockActive = REG_READ(SPI_MEM_SRAM_CLK_REG(0));
+        s_trace.beforeStartKhz = measuredKhz();
+        s_trace.canary = checkRam() ? 1 : -1;
+        ok = s_trace.canary == 1;
+        if (ok && mode != 0) ok = restartWifi(mode);
+        s_trace.stage = 4;
+        if (mode == 0) s_trace.afterStartKhz = measuredKhz();
+    }
+    if (ok) {
+        s_trace.stage = 5;
+        const int64_t until = esp_timer_get_time() + 8000000;
+        int64_t next = esp_timer_get_time();
+        while (!s_ip && esp_timer_get_time() < until) {
+            if (esp_timer_get_time() >= next) { sample(); next += 1000000; }
+            vTaskDelay(pdMS_TO_TICKS(20));
+        }
+        if (s_ip) {
+            const uint32_t khz = measuredKhz();
+            if (khz > mhz * 990 && khz < mhz * 1010) {
+                bool posted = false;
+                daw::control::call([&] {
+                    daw::EngineCmd seek{daw::EngineCmd::Seek}; seek.i[0] = 725760;
+                    posted = s_engine->post(seek) && s_engine->post(daw::EngineCmd{daw::EngineCmd::Play});
+                }, 1000);
+                if (posted) { s_trace.stage = 7; waitSampled(mode == 0 ? 18000 : 12000); }
+            }
+        } else {
+            s_trace.stage = 6;
+            s_trace.calls[10] = esp_wifi_disconnect();
+            wifi_scan_config_t scan = {}; scan.channel = 0; scan.scan_type = WIFI_SCAN_TYPE_ACTIVE;
+            scan.scan_time.active.min = 50; scan.scan_time.active.max = 100;
+            s_trace.calls[11] = esp_wifi_scan_start(&scan, false);
+            waitSampled(2500);
+        }
+    }
+    s_trace.stage = 8;
+    switchClock(240); s_trace.restoredKhz = measuredKhz();
+    s_trace.restoredApbHz = measuredApbHz();
+    wdt_hal_write_protect_disable(&s_rescue); wdt_hal_disable(&s_rescue); wdt_hal_write_protect_enable(&s_rescue);
+    s_trace.stage = 9;
+    heap_caps_free(const_cast<uint32_t *>(s_probe)); s_probe = nullptr;
+    for (unsigned i = 0; i < sizeof s_wifi; ++i) reinterpret_cast<volatile uint8_t *>(&s_wifi)[i] = 0;
+    vTaskDelay(pdMS_TO_TICKS(200)); esp_restart();
+}
+
+bool clockWifiStart(uint32_t mhz, uint32_t mode)
+{
+    if ((mhz != 240 && mhz != 260) || mode > 3 || s_busy.exchange(true)) return false;
+    s_probe = static_cast<volatile uint32_t *>(heap_caps_malloc(kWords * 4, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (!s_probe) { s_busy = false; return false; }
+    if (xTaskCreatePinnedToCore(trialTask, "clock-wifi", 6144, reinterpret_cast<void *>(uintptr_t(mhz | mode << 16)), 24, nullptr, 0) != pdPASS) {
+        heap_caps_free(const_cast<uint32_t *>(s_probe)); s_probe = nullptr; s_busy = false; return false;
+    }
+    return true;
+}
+
+void clockWifiDiag(cJSON *d)
+{
+    cJSON *o = cJSON_AddObjectToObject(d, "clockWifi");
+    cJSON_AddBoolToObject(o, "busy", s_busy.load()); cJSON_AddNumberToObject(o, "measuredKhzNow", s_actualKhz.load());
+    cJSON_AddNumberToObject(o, "apbHzMeasuredNow", s_apbHz.load());
+    cJSON_AddBoolToObject(o, "connected", s_connected.load()); cJSON_AddBoolToObject(o, "hasIp", s_ip.load());
+    if (s_trace.magic != kMagic) return;
+    #define ADD(name) cJSON_AddNumberToObject(o, #name, s_trace.name)
+    ADD(target); ADD(mode); ADD(stage); ADD(beforeStartKhz); ADD(afterInitKhz); ADD(afterStartKhz);
+    ADD(restoredKhz); ADD(canary); ADD(gotIpMs); ADD(ipEver); ADD(scanDone); ADD(scanAps);
+    ADD(stopConfirmed);
+    ADD(slowMemory); ADD(mspiCoreSelect); ADD(flashClockBefore); ADD(psramClockBefore); ADD(flashClockActive); ADD(psramClockActive);
+    ADD(bootApbHz); ADD(afterStartApbHz); ADD(restoredApbHz);
+    #undef ADD
+    if (!s_busy) {
+        cJSON *calls = cJSON_AddArrayToObject(o, "calls");
+        for (int v : s_trace.calls) cJSON_AddItemToArray(calls, cJSON_CreateNumber(v));
+        cJSON *events = cJSON_AddArrayToObject(o, "events");
+        for (unsigned i = 0; i < s_trace.eventCount && i < 32; ++i) {
+            auto &e = s_trace.events[i]; cJSON *v = cJSON_CreateObject();
+            cJSON_AddNumberToObject(v, "ms", e.ms); cJSON_AddNumberToObject(v, "stage", e.stage);
+            cJSON_AddNumberToObject(v, "id", e.id); cJSON_AddNumberToObject(v, "reason", e.reason); cJSON_AddItemToArray(events,v);
+        }
+        cJSON *samples = cJSON_AddArrayToObject(o, "samples");
+        for (unsigned i = 0; i < s_trace.sampleCount && i < 24; ++i) {
+            auto &s = s_trace.samples[i]; cJSON *v = cJSON_CreateObject();
+            #define FIELD(name) cJSON_AddNumberToObject(v, #name, (double)s.name)
+            FIELD(ms); FIELD(khz); FIELD(overruns); FIELD(underruns); FIELD(playing); FIELD(tick); FIELD(guardDrops); FIELD(frames);
+            #undef FIELD
+            cJSON_AddNumberToObject(v, "cpu", s.cpu / 10.0); cJSON_AddItemToArray(samples,v);
+        }
+    }
+}
