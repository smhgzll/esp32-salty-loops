+// SPDX-License-Identifier: GPL-3.0-or-later
+// Temporary board-only clock lab. Never overclocks at boot; remove after measurement.
+// BBPLL method: ESP-IDF S3 clock LL; experimental precedent Neol00/OpenWatchFace (GPL-3.0).
+#include "clock_trial.hpp"
+#include "sdkconfig.h"
+#if CONFIG_DAW_CLOCK_TRIAL
+#include <atomic>
+#include "audio_out.hpp"
+#include "control.hpp"
+#include "esp_attr.h"
+#include "esp_cpu.h"
+#include "esp_heap_caps.h"
+#include "esp_event.h"
+#include "esp_wifi.h"
+#include "esp_private/cache_utils.h"
+#include "esp_rom_regi2c.h"
+#include "esp_rom_sys.h"
+#include "esp_system.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "hal/clk_tree_ll.h"
+#include "hal/mspi_ll.h"
+#include "hal/wdt_hal.h"
+#include "soc/regi2c_bbpll.h"
+#include "soc/rtc.h"
+
+static daw::Engine *s_engine;
+static std::atomic<bool> s_busy{false};
+static volatile uint32_t *s_probe;
+static constexpr unsigned kWords = 16384;
+static constexpr uint32_t kMagic = 0xc10c0320;
+static bool s_slowMemory;
+static uint32_t s_flash0, s_flash1, s_psram0, s_flashDiv0, s_flashDiv1, s_psramDiv;
+struct Sample {
+    int64_t us; uint64_t frames;
+    uint32_t cpu, overruns, underruns, playing, tick, guardDrops, nanResets;
+};
+struct Trace {
+    uint32_t magic, target, stage, actualKhz, restoredKhz, computeExpected, computeActual;
+    int32_t canary; unsigned count, wifiDisconnects, wifiLastReason;
+    uint32_t slowMemory, flashClockBefore, psramClockBefore, flashClockActive, psramClockActive, mspiCoreSelect;
+    Sample samples[13];
+};
+static RTC_NOINIT_ATTR Trace s_trace;
+static wdt_hal_context_t s_rescue;
+
+static void wifiEvent(void *, esp_event_base_t, int32_t id, void *data)
+{
+    if (id == WIFI_EVENT_STA_DISCONNECTED && s_trace.magic == kMagic && s_busy && s_trace.stage >= 2 && s_trace.stage <= 5) {
+        ++s_trace.wifiDisconnects;
+        s_trace.wifiLastReason = static_cast<wifi_event_sta_disconnected_t *>(data)->reason;
+    }
+}
+
+void clockTrialBind(daw::Engine *engine)
+{
+    s_engine = engine;
+    ESP_ERROR_CHECK(esp_event_handler_register(WIFI_EVENT, WIFI_EVENT_STA_DISCONNECTED, wifiEvent, nullptr));
+}
+
+static void sample()
+{
+    if (s_trace.count >= 13) return;
+    auto &a = daw::audioOutStats(); auto &e = s_engine->status();
+    s_trace.samples[s_trace.count++] = {esp_timer_get_time(), a.frames.load(), e.cpuPermille.load(),
+        e.overruns.load(), a.underruns.load(), e.playing.load(), (uint32_t)e.tick.load(),
+        e.cpuGuardDrops.load(), e.nanResets.load()};
+}
+
+static void rescueArm()
+{
+    // Separate RTC slow-clock watchdog: recovery does not rely on CPU timing or network.
+    wdt_hal_init(&s_rescue, WDT_RWDT, 0, false);
+    wdt_hal_write_protect_disable(&s_rescue);
+    const uint32_t hz = rtc_clk_slow_freq_get_hz();
+    wdt_hal_config_stage(&s_rescue, WDT_STAGE0, hz * 18, WDT_STAGE_ACTION_RESET_SYSTEM);
+    wdt_hal_config_stage(&s_rescue, WDT_STAGE1, hz * 2, WDT_STAGE_ACTION_RESET_RTC);
+    wdt_hal_enable(&s_rescue);
+    wdt_hal_write_protect_enable(&s_rescue);
+}
+
+static void rescueDisable()
+{
+    wdt_hal_write_protect_disable(&s_rescue);
+    wdt_hal_disable(&s_rescue);
+    wdt_hal_write_protect_enable(&s_rescue);
+}
+
+static void IRAM_ATTR switchClock(uint32_t mhz)
+{
+    spi_flash_disable_interrupts_caches_and_other_cpu();
+    clk_ll_cpu_set_src(SOC_CPU_CLK_SRC_XTAL);
+    esp_rom_set_cpu_ticks_per_us(40);
+    if (s_slowMemory && mhz > 240) {
+        mspi_timing_ll_set_flash_clock(0, s_flashDiv0 * 2);
+        mspi_timing_ll_set_flash_clock(1, s_flashDiv1 * 2);
+        mspi_timing_ll_set_psram_clock(0, s_psramDiv * 2);
+    }
+    esp_rom_regi2c_write(I2C_BBPLL, I2C_BBPLL_HOSTID, I2C_BBPLL_OC_DIV_7_0,
+                        static_cast<uint8_t>(mhz / 20 - 4));
+    REG_SET_FIELD(SYSTEM_CPU_PER_CONF_REG, SYSTEM_PLL_FREQ_SEL, 1);
+    esp_rom_delay_us(100);
+    clk_ll_cpu_set_freq_mhz_from_pll(240); // keep CPU /2; the VCO supplies the requested speed
+    clk_ll_cpu_set_src(SOC_CPU_CLK_SRC_PLL);
+    esp_rom_set_cpu_ticks_per_us(mhz);
+    if (s_slowMemory && mhz == 240) {
+        REG_WRITE(SPI_MEM_CLOCK_REG(0), s_flash0);
+        REG_WRITE(SPI_MEM_CLOCK_REG(1), s_flash1);
+        REG_WRITE(SPI_MEM_SRAM_CLK_REG(0), s_psram0);
+    }
+    spi_flash_enable_interrupts_caches_and_other_cpu();
+}
+
+static uint32_t IRAM_ATTR measuredKhz()
+{
+    const int64_t t0 = esp_timer_get_time();
+    const uint32_t c0 = esp_cpu_get_cycle_count();
+    int64_t t1;
+    do { t1 = esp_timer_get_time(); } while (t1 - t0 < 2000);
+    return static_cast<uint32_t>(uint64_t(esp_cpu_get_cycle_count() - c0) * 1000 / (t1 - t0));
+}
+
+static uint32_t IRAM_ATTR computeProbe(uint32_t seed)
+{
+    uint32_t x = seed;
+    for (unsigned i = 0; i < 16384; ++i) {
+        x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+        x += i * 73u;
+        asm volatile("" : "+r"(x));
+    }
+    return x;
+}
+
+static bool IRAM_ATTR checkRam()
+{
+    for (unsigned i = 0; i < kWords; ++i) s_probe[i] = i * 2654435761u ^ 0x59a36cb7u;
+    for (unsigned i = 0; i < kWords; ++i)
+        if (s_probe[i] != (i * 2654435761u ^ 0x59a36cb7u)) return false;
+    return true;
+}
+
+static void trialTask(void *arg)
+{
+    const uint32_t encoded = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(arg));
+    const uint32_t mhz = encoded & 0xffff;
+    s_slowMemory = (encoded & 0x10000) != 0;
+    vTaskDelay(pdMS_TO_TICKS(500)); // send the HTTP acknowledgement at stock clock
+    s_trace = {};
+    s_trace.magic = kMagic; s_trace.target = mhz; s_trace.stage = 1;
+    s_flash0 = REG_READ(SPI_MEM_CLOCK_REG(0)); s_flash1 = REG_READ(SPI_MEM_CLOCK_REG(1));
+    s_psram0 = REG_READ(SPI_MEM_SRAM_CLK_REG(0));
+    s_flashDiv0 = (s_flash0 & SPI_MEM_CLK_EQU_SYSCLK) ? 1 : REG_GET_FIELD(SPI_MEM_CLOCK_REG(0), SPI_MEM_CLKCNT_N) + 1;
+    s_flashDiv1 = (s_flash1 & SPI_MEM_CLK_EQU_SYSCLK) ? 1 : REG_GET_FIELD(SPI_MEM_CLOCK_REG(1), SPI_MEM_CLKCNT_N) + 1;
+    s_psramDiv = (s_psram0 & SPI_MEM_SCLK_EQU_SYSCLK) ? 1 : REG_GET_FIELD(SPI_MEM_SRAM_CLK_REG(0), SPI_MEM_SCLKCNT_N) + 1;
+    s_trace.slowMemory = s_slowMemory;
+    s_trace.flashClockBefore = s_flash0; s_trace.psramClockBefore = s_psram0;
+    s_trace.mspiCoreSelect = REG_GET_FIELD(SPI_MEM_CORE_CLK_SEL_REG(0), SPI_MEM_CORE_CLK_SEL);
+    s_trace.computeExpected = computeProbe(0x31415926);
+    rescueArm();
+    switchClock(mhz);
+    s_trace.stage = 2;
+    s_trace.flashClockActive = REG_READ(SPI_MEM_CLOCK_REG(0));
+    s_trace.psramClockActive = REG_READ(SPI_MEM_SRAM_CLK_REG(0));
+    s_trace.actualKhz = measuredKhz();
+    s_trace.stage = 3;
+    s_trace.computeActual = computeProbe(0x31415926);
+    if (s_trace.computeExpected != s_trace.computeActual) s_trace.canary = -2;
+    else if (s_trace.actualKhz < mhz * 990 || s_trace.actualKhz > mhz * 1010) s_trace.canary = -3;
+    else s_trace.canary = checkRam() ? 1 : -1;
+    if (s_trace.canary == 1) {
+        s_trace.stage = 4;
+        // Post only through the sole engine-command producer (control task).
+        bool posted = false;
+        const bool callOk = daw::control::call([&] {
+            daw::EngineCmd seek{daw::EngineCmd::Seek}; seek.i[0] = 725760; // 180 s at project tempo252
+            posted = s_engine->post(seek) && s_engine->post(daw::EngineCmd{daw::EngineCmd::Play});
+        }, 1000);
+        if (callOk && posted) {
+            const int64_t until = esp_timer_get_time() + 12000000;
+            int64_t next = esp_timer_get_time();
+            s_trace.stage = 5;
+            while (esp_timer_get_time() < until) {
+                if (esp_timer_get_time() >= next) { sample(); next += 1000000; }
+                vTaskDelay(pdMS_TO_TICKS(20));
+            }
+            sample();
+            if (!checkRam()) s_trace.canary = -1;
+        } else s_trace.canary = -4;
+    }
+    s_trace.stage = 6;
+    switchClock(240);
+    s_trace.restoredKhz = measuredKhz();
+    s_trace.stage = 7;
+    rescueDisable();
+    heap_caps_free(const_cast<uint32_t *>(s_probe)); s_probe = nullptr;
+    s_trace.stage = 8;
+    vTaskDelay(pdMS_TO_TICKS(200));
+    esp_restart(); // restore radio initialization at stock clock as well
+}
+
+bool clockTrialStart(uint32_t encoded)
+{
+    const uint32_t mhz = encoded & 0xffff;
+    if (mhz != 240 && mhz != 280 && mhz != 300 && mhz != 320) return false;
+    if (s_busy.exchange(true)) return false;
+    s_probe = static_cast<volatile uint32_t *>(heap_caps_malloc(kWords * 4, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (!s_probe) { s_busy = false; return false; }
+    if (xTaskCreatePinnedToCore(trialTask, "clock-lab", 4096, reinterpret_cast<void *>(uintptr_t(encoded)), 24, nullptr, 0) != pdPASS) {
+        heap_caps_free(const_cast<uint32_t *>(s_probe)); s_probe = nullptr; s_busy = false; return false;
+    }
+    return true;
+}
+
+void clockTrialDiag(cJSON *d)
+{
+    cJSON *o = cJSON_AddObjectToObject(d, "clockTrial");
+    cJSON_AddBoolToObject(o, "busy", s_busy.load());
+    if (s_trace.magic != kMagic) return;
+    cJSON_AddNumberToObject(o, "targetMHz", s_trace.target);
+    cJSON_AddNumberToObject(o, "stage", s_trace.stage);
+    cJSON_AddNumberToObject(o, "measuredKhz", s_trace.actualKhz);
+    cJSON_AddNumberToObject(o, "restoredKhz", s_trace.restoredKhz);
+    cJSON_AddNumberToObject(o, "canary", s_trace.canary);
+    cJSON_AddNumberToObject(o, "computeExpected", s_trace.computeExpected);
+    cJSON_AddNumberToObject(o, "computeActual", s_trace.computeActual);
+    cJSON_AddNumberToObject(o, "wifiDisconnects", s_trace.wifiDisconnects);
+    cJSON_AddNumberToObject(o, "wifiLastReason", s_trace.wifiLastReason);
+    cJSON_AddBoolToObject(o, "slowMemory", s_trace.slowMemory);
+    cJSON_AddNumberToObject(o, "flashClockBefore", s_trace.flashClockBefore);
+    cJSON_AddNumberToObject(o, "psramClockBefore", s_trace.psramClockBefore);
+    cJSON_AddNumberToObject(o, "flashClockActive", s_trace.flashClockActive);
+    cJSON_AddNumberToObject(o, "psramClockActive", s_trace.psramClockActive);
+    cJSON_AddNumberToObject(o, "mspiCoreSelect", s_trace.mspiCoreSelect);
+    if (!s_busy) {
+        cJSON *a = cJSON_AddArrayToObject(o, "samples");
+        for (unsigned i = 0; i < s_trace.count && i < 13; ++i) {
+            const Sample &s = s_trace.samples[i]; cJSON *v = cJSON_CreateObject();
+            cJSON_AddNumberToObject(v, "us", (double)s.us);
+            cJSON_AddNumberToObject(v, "frames", (double)s.frames);
+            cJSON_AddNumberToObject(v, "cpu", s.cpu / 10.0);
+            cJSON_AddNumberToObject(v, "overruns", s.overruns);
+            cJSON_AddNumberToObject(v, "underruns", s.underruns);
+            cJSON_AddNumberToObject(v, "playing", s.playing);
+            cJSON_AddNumberToObject(v, "tick", s.tick);
+            cJSON_AddNumberToObject(v, "guardDrops", s.guardDrops);
+            cJSON_AddNumberToObject(v, "nanResets", s.nanResets);
+            cJSON_AddItemToArray(a, v);
+        }
+    }
+}
+#endif
--- a/main/clock_trial.hpp
+++ b/main/clock_trial.hpp
@@ -0,0 +1,7 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "cJSON.h"
+#include "daw/engine.hpp"
+void clockTrialBind(daw::Engine *engine);
+bool clockTrialStart(uint32_t mhz);
+void clockTrialDiag(cJSON *d);
