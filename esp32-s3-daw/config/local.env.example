# Copy to config/local.env (gitignored) and edit before building for real hardware.
# scripts/build-hardware.sh turns it into config/sdkconfig.local.defaults (also gitignored).

# Wi-Fi: AP = the device's own access point (WPA2, password >= 8 characters), STA = join a network
# (falls back to its own AP when the network is unreachable).
DAW_WIFI_MODE=AP
DAW_WIFI_SSID=ESP32-DAW
DAW_WIFI_PASSWORD=change-this-password
DAW_HOSTNAME=esp32daw

# Password for privileged operations from the browser: firmware update, factory reset,
# project restore, settings. Empty = those operations are disabled.
DAW_ADMIN_PASSWORD=change-this-admin-password

# Optional overrides after checking the actual board with esptool flash_id.
# For a board with 32 MB octal flash (selects the 22 MiB sample-library partition layout):
# DAW_FLASH_SIZE_MB=32
# DAW_OCTAL_FLASH=1

# Optional audio capacity profile: 44100 (default), 32000 (less CPU, 16 kHz bandwidth), 48000.
# DAW_SAMPLE_RATE=44100

# PCM5102A wiring. The defaults are the MEASURED pins of the reference build (the ESP32-S3 sits on
# an adapter made for the ESP32-WROOM-32 whose labels are wrong): BCK GPIO16 (label IO33),
# LCK GPIO6 (label IO34), DIN GPIO7 (label IO35). Change only after measuring your own board.
DAW_I2S_BCLK_GPIO=16
DAW_I2S_WS_GPIO=6
DAW_I2S_DOUT_GPIO=7

# Serial port of the board (scripts/flash.sh, scripts/monitor.sh)
DAW_SERIAL_PORT=/dev/ttyACM0
