+  // esp32-daw-plugin-sdk modification: the noise generator's state (stmlib::Random's algorithm)
+  // belongs to the owner, which may share one state between its oscillators. Upstream draws from
+  // one static generator, which made every oscillator in the program share it: two owners could
+  // not render at the same time on two cores.
+  inline void set_random_state(uint32_t* state) {
+    random_state_ = state;
+  }
+
   void Render(const uint8_t* sync, int16_t* buffer, size_t size);
   
  private:
+  inline uint32_t RandomWord() {
+    *random_state_ = *random_state_ * 1664525L + 1013904223L;
+    return *random_state_;
+  }
+  inline int16_t RandomSample() {
+    return static_cast<int16_t>(RandomWord() >> 16);
+  }
+  static uint32_t default_random_state_;
+  uint32_t* random_state_ = &default_random_state_;
+
   void RenderTripleRingMod(const uint8_t*, int16_t*, size_t);
   void RenderSawSwarm(const uint8_t*, int16_t*, size_t);
   void RenderComb(const uint8_t*, int16_t*, size_t);
